# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:AA...

# Часовой пояс, по которому будут срабатывать расписания (IANA формат)
TZ=Asia/Almaty

# Время отправки ежедневных испытаний для каждого слота (HH:MM, 24ч формат)
TIME_MORNING=05:00
TIME_DAY=13:00
TIME_EVENING=19:00
TIME_NIGHT=23:00

# Через сколько часов после старта испытание считается просроченным
CHALLENGE_TIMEOUT_HOURS=18

# На сколько часов налагается штраф при нажатии "Сдаться"
PENALTY_HOURS=48

# Путь к файлу базы данных SQLite (внутри контейнера)
DB_PATH=/app/storage/db.sql

# ---------- Автобэкап БД в приватный GitHub-репозиторий ----------
# HTTPS-урл приватного репозитория, куда будет коммититься db.sql.
# Если оставить пустым - автобэкап просто выключен.
BACKUP_REPO_URL=https://github.com/username/solo-leveling-backups.git

# Personal Access Token (Settings -> Developer settings -> Fine-grained tokens)
# с правом Contents: Read and write ИМЕННО на этот репозиторий. Вшивается в
# урл при push, нигде не логируется.
BACKUP_GITHUB_TOKEN=

# Имя/email автора коммитов бэкапа (может быть любым, на права не влияет)
BACKUP_GIT_USER_NAME=solo-leveling-bot
BACKUP_GIT_USER_EMAIL=backup@bot.local

# Два дня в неделю, когда делается бэкап (mon/tue/wed/thu/fri/sat/sun),
# максимально равноудалённых друг от друга + время (HH:MM по TZ бота)
BACKUP_DAY_1=mon
BACKUP_DAY_2=thu
BACKUP_TIME=04:00

# (необязательно) chat_id, куда бот пришлёт сообщение, если push бэкапа не удался
BACKUP_NOTIFY_CHAT_ID=
