# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:AA...

# Часовой пояс, по которому будут срабатывать расписания (IANA формат)
TZ=Asia/Almaty

# Время отправки ежедневных испытаний для каждого слота (HH:MM, 24ч формат)
TIME_MORNING=05:00
TIME_DAY=13:00
TIME_EVENING=19:00
TIME_NIGHT=23:00

# Через сколько часов после старта испытание считается просроченным
CHALLENGE_TIMEOUT_HOURS=18

# На сколько часов приостанавливаются новые испытания при штрафе (2-й провал подряд)
PENALTY_HOURS=48

# После скольких проваленных ежедневных испытаний ПОДРЯД Система замораживается сама
# (возобновить - командой /start). На этом провале штраф НЕ накладывается. 1-й провал подряд -
# заморозка серии, 2-й - штраф (-XP, серия обнулена, новые испытания приостановлены на
# PENALTY_HOURS), 3-й - заморозка Системы. Выполненное испытание обнуляет счётчик.
AUTO_STOP_AFTER_FAILURES=3

# Через сколько минут после отправки удаляется уведомление о проваленном испытании
FAILURE_MESSAGE_TTL_MINUTES=5

# Отказоустойчивая выдача квестов: сколько повторных попыток доставить карточку
# после неудачной (слот, +1ч, +2ч, +3ч), шаг между ними (минуты) и окно (минуты),
# в течение которого досылается слот, пропущенный из-за простоя бота. После
# исчерпания попыток игрок пропускается до следующего дня.
DISPATCH_RETRY_ATTEMPTS=3
DISPATCH_RETRY_INTERVAL_MINUTES=60
DISPATCH_CATCHUP_WINDOW_MINUTES=180

# Как часто (в секундах) обновляется таймер ММ:СС в карточке испытания в последние
# 15 минут до провала. Меньше - плавнее, но выше риск flood-control Telegram.
CHALLENGE_COUNTDOWN_REFRESH_SECONDS=1

# Сколько попыток делается при обновлении/отправке/закреплении/удалении сообщения
# профиля, прежде чем признать сбой (минимум 3) и пауза между попытками (секунды).
PROFILE_RETRY_ATTEMPTS=3
# Интервал между попытками отредактировать профиль перед его переотправкой (секунды).
PROFILE_EDIT_RETRY_INTERVAL_SECONDS=30
PROFILE_RETRY_DELAY_SECONDS=1.0

# Telegram не даёт редактировать/удалять сообщения старше 48 часов. Профиль (закреплённое
# сообщение) поэтому пересоздаётся при выдаче ежедневного квеста - прямо над новой карточкой:
# если до следующей выдачи (+ PROFILE_DISPATCH_LOOKAHEAD_HOURS) он перейдёт границу
# (окно - запас = 42 ч), он обновляется сейчас. Остановленным игрокам новый профиль не
# присылается - старый тихо удаляется до границы (см. README).
PROFILE_EDIT_WINDOW_HOURS=48
PROFILE_REFRESH_BUFFER_HOURS=6
PROFILE_DISPATCH_LOOKAHEAD_HOURS=24

# Путь к файлу базы данных SQLite (внутри контейнера)
DB_PATH=/app/storage/db.sql

# Дополнительная локальная БД состояния (внутри контейнера): ключи сообщений профиля и отчёта
# о провале, кэш file_id PDF-гайда, очередь автоудаления сообщений. Держите её на ОТДЕЛЬНОМ
# томе (см. docker-compose.yml) - тогда откат db.sql из бэкапа не ломает редактирование
# профилей. Не задано - файл bot_state.db создаётся рядом с DB_PATH.
STATE_DB_PATH=/app/state/bot_state.db

# ---------- Автобэкап БД в приватный GitHub-репозиторий ----------
# HTTPS-урл приватного репозитория, куда будет коммититься db.sql.
# Если оставить пустым - автобэкап просто выключен.
BACKUP_REPO_URL=https://github.com/username/solo-leveling-backups.git

# Personal Access Token (Settings -> Developer settings -> Fine-grained tokens)
# с правом Contents: Read and write ИМЕННО на этот репозиторий. Вшивается в
# урл при push, нигде не логируется.
BACKUP_GITHUB_TOKEN=

# Имя/email автора коммитов бэкапа (может быть любым, на права не влияет)
BACKUP_GIT_USER_NAME=solo-leveling-bot
BACKUP_GIT_USER_EMAIL=backup@bot.local

# Два дня в неделю, когда делается бэкап (mon/tue/wed/thu/fri/sat/sun),
# максимально равноудалённых друг от друга + время (HH:MM по TZ бота)
BACKUP_DAY_1=mon
BACKUP_DAY_2=thu
BACKUP_TIME=04:00

# (необязательно) chat_id, куда бот пришлёт сообщение, если push бэкапа не удался
BACKUP_NOTIFY_CHAT_ID=
